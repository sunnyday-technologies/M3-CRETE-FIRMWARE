license: GPL-3.0-only
repository-code: "https://github.com/sunnyday-technologies/M3-CRETE-FIRMWARE"
url: "https://m3-crete.com"
keywords:
  - 3D-printing
  - concrete
  - firmware
  - klipper
  - marlin
  - open-hardware
  - 3DCP
  - additive-manufacturing
